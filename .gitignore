# Modified for MaxDrop, 2026-11-14: the build output and the local corpus are added below.
# Modified for MaxDrop, 2026-11-15: archives of any name (scene packs), except the test packs.

# Librarys.
lib/
.env
.venv
.json

# Python temp paths.
__pycache__/
__pypackages__/
*.py[cod]
.pytype/

# Editors.
*~
*.swp
*.swo
*#

# Local patches.
.patch
.diff

# Locally built extensions, and scene packs (archives of scenes that are not ours). Test packs are the
# self-made files of tests/fixtures/packs/ only.
*.zip
*.rar
*.7z
!tests/fixtures/packs/*.zip
!tests/fixtures/packs/*.rar
!tests/fixtures/packs/*.7z

# MaxDrop: the build output (build.ps1).
dist/

# MaxDrop: scenes that are not ours never enter the repository. Fixtures are the self-authored files of
# tests/fixtures/ only.
corpus/
*.max
!tests/fixtures/*.max

.beads/proxieddb/

